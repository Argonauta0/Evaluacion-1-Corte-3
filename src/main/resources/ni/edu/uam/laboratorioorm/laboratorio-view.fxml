<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="TOP_CENTER" prefHeight="620.0" prefWidth="880.0" spacing="12.0"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="ni.edu.uam.laboratorioorm.controller.LaboratorioController">
    <children>
        <Label text="Control de Equipos de Laboratorio">
            <font>
                <Font name="System Bold" size="20.0" />
            </font>
        </Label>

        <!-- Formulario de datos del equipo -->
        <GridPane hgap="12.0" vgap="8.0">
            <columnConstraints>
                <ColumnConstraints hgrow="NEVER" minWidth="75.0" />
                <ColumnConstraints hgrow="ALWAYS" prefWidth="260.0" />
                <ColumnConstraints hgrow="NEVER" minWidth="95.0" />
                <ColumnConstraints hgrow="ALWAYS" prefWidth="260.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints />
                <RowConstraints />
                <RowConstraints />
            </rowConstraints>
            <children>
                <Label text="Código:" />
                <TextField fx:id="txtCodigo" promptText="Ej. EQ-PC-004" GridPane.columnIndex="1" />

                <Label text="Tipo Equipo:" GridPane.columnIndex="2" />
                <ComboBox fx:id="cmbTipoEquipo" maxWidth="1.7976931348623157E308"
                          promptText="Seleccione un tipo" GridPane.columnIndex="3" />

                <Label text="Nombre:" GridPane.rowIndex="1" />
                <TextField fx:id="txtNombre" promptText="Nombre del equipo" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                <Label text="Estado:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                <ComboBox fx:id="cmbEstado" maxWidth="1.7976931348623157E308"
                          promptText="Seleccione el estado" GridPane.columnIndex="3" GridPane.rowIndex="1" />

                <Label text="Marca:" GridPane.rowIndex="2" />
                <TextField fx:id="txtMarca" promptText="Marca (opcional)" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                <Label text="Cantidad:" GridPane.columnIndex="2" GridPane.rowIndex="2" />
                <TextField fx:id="txtCantidad" promptText="Cantidad (>= 0)" GridPane.columnIndex="3" GridPane.rowIndex="2" />
            </children>
        </GridPane>

        <!-- Botonera CRUD -->
        <HBox alignment="CENTER" spacing="10.0">
            <children>
                <Button fx:id="btnGuardar" mnemonicParsing="false" onAction="#guardarEquipo" text="Guardar" />
                <Button fx:id="btnActualizar" mnemonicParsing="false" onAction="#actualizarEquipo" text="Actualizar" />
                <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#eliminarEquipo" text="Eliminar" />
                <Button fx:id="btnLimpiar" mnemonicParsing="false" onAction="#limpiarFormulario" text="Limpiar" />
            </children>
        </HBox>

        <Separator />

        <!-- Barra de búsqueda parcial y filtro por tipo -->
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <children>
                <Label text="Buscar nombre:" />
                <TextField fx:id="txtBuscarNombre" prefWidth="230.0" promptText="Fragmento del nombre..." />

                <Label text="Filtrar por tipo:" />
                <ComboBox fx:id="cmbFiltroTipo" prefWidth="220.0" promptText="Todos los tipos" />

                <Button fx:id="btnBuscar" mnemonicParsing="false" onAction="#aplicarFiltros" text="Buscar / Filtrar" />
                <Button fx:id="btnMostrarTodos" mnemonicParsing="false" onAction="#limpiarFiltros" text="Mostrar Todos" />
            </children>
        </HBox>

        <!-- Tabla de equipos -->
        <TableView fx:id="tblEquipos" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="colCodigo" prefWidth="110.0" style="-fx-alignment: CENTER;" text="Código" />
                <TableColumn fx:id="colNombre" prefWidth="220.0" text="Nombre" />
                <TableColumn fx:id="colMarca" prefWidth="110.0" text="Marca" />
                <TableColumn fx:id="colEstado" prefWidth="135.0" style="-fx-alignment: CENTER;" text="Estado" />
                <TableColumn fx:id="colCantidad" prefWidth="85.0" style="-fx-alignment: CENTER;" text="Cantidad" />
                <TableColumn fx:id="colTipoEquipo" prefWidth="190.0" text="Tipo de Equipo" />
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <placeholder>
                <Label text="No se encontraron equipos registrados con los criterios indicados." />
            </placeholder>
        </TableView>
    </children>
    <padding>
        <Insets bottom="15.0" left="15.0" right="15.0" top="15.0" />
    </padding>
</VBox>